# Environment Configuration
ENV=development
APP_NAME="Autonomous B2B Supply Chain & Procurement Agent"
HOST=127.0.0.1
PORT=8000
UI_PORT=8501

# Security & Cryptography
SECRET_KEY=b2b-procurement-agent-enterprise-secret-key-hs256-deterministic-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
# Default: Local SQLite (zero configuration required)
DATABASE_URL=sqlite:///./data/procurement_local.db
# PostgreSQL Alternative:
# DATABASE_URL=postgresql://procure_user:procure_pass@localhost:5432/procurement_db

# Commercial Tolerance & Guardrails
VARIANCE_TOLERANCE_PCT=2.0
HIGH_VALUE_THRESHOLD_USD=10000.0

# Unit Economics Parameters
MANUAL_MINUTES_PER_INVOICE=18.0
HOURLY_ANALYST_WAGE_USD=45.0
TOKEN_COST_PER_1K_USD=0.002
INFRA_COST_USD=15.00
