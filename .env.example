# Environment Configuration
ENV=development
HOST=127.0.0.1
PORT=8000
UI_PORT=8501

# Security & Cryptography
# Leave SECRET_KEY empty for local development: a random per-installation key is
# generated in data/.jwt_secret (mode 600, git-ignored). It is REQUIRED in production:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=procurement-agent-api
JWT_AUDIENCE=procurement-agent-clients
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Network hardening
CORS_ORIGINS=http://127.0.0.1:8501,http://localhost:8501
TRUSTED_HOSTS=127.0.0.1,localhost
MAX_REQUEST_BODY_BYTES=1048576

# Demo personas (seeded automatically outside production). In production set
# DEMO_MODE=true AND every DEMO_*_PASSWORD explicitly, or no demo users are created.
DEMO_MODE=true
DEMO_ANALYST_PASSWORD=
DEMO_CPO_PASSWORD=
DEMO_AUDITOR_PASSWORD=
DEMO_BETA_PASSWORD=

# Database
# Default: Local SQLite (zero configuration required)
DATABASE_URL=sqlite:///./data/procurement_local.db
# PostgreSQL Alternative:
# DATABASE_URL=postgresql://procure_user:<password>@localhost:5432/procurement_db

# Commercial Tolerance & Guardrails
VARIANCE_TOLERANCE_PCT=2.0
HIGH_VALUE_THRESHOLD_USD=10000.0
CPO_APPROVAL_THRESHOLD_USD=25000.0

# Unit Economics Parameters
MANUAL_MINUTES_PER_INVOICE=18.0
HOURLY_ANALYST_WAGE_USD=45.0
TOKEN_COST_PER_1K_USD=0.002
INFRA_COST_USD=15.00
